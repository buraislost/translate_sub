{
  "manifest_version": 3,
  "name": "SubForge",
  "version": "0.1.0",
  "description": "Reads subtitles burned into any web video and shows an English translation alongside — or plays two subtitle files at once.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "SubForge",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/main.js",
        "src/core/*.js",
        "src/sources/*.js",
        "src/adapters/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
